# Oneliq — environment variables template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#   chmod 600 .env

# ─── Production hosts ────────────────────────────────────────────────────────
# Primary domain (Cloudflare Pages)
APP_URL=https://oneliq.xyz

# ─── Cloudflare ──────────────────────────────────────────────────────────────
# For wrangler CLI deploys (https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The Pages project kept its original name from before the rebrand.
CLOUDFLARE_PROJECT_NAME=arcswap

# ─── Arc Mainnet ─────────────────────────────────────────────────────────────
ARC_RPC=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_EXPLORER=https://explorer.arc.io
# Arc's CCTP domain
ARC_CCTP_DOMAIN=26

# ─── Circle CCTP (mainnet) ───────────────────────────────────────────────────
IRIS_BASE=https://iris-api.circle.com/v2

# ─── Token addresses on Arc Mainnet (read-only — no private key needed) ──────
# USDC is the native gas token; this is its ERC-20 face. 18 decimals natively,
# 6 for CCTP accounting.
USDC_TOKEN=0x3600000000000000000000000000000000000000
EURC_TOKEN=0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1

# ─── Oneliq's own contracts on Arc Mainnet ───────────────────────────────────
# ONELIQ_ROUTER is the live one (feeBps 30, routes v4 + v3). The v4-only
# predecessor is kept so historical swaps still attribute in metrics.
ONELIQ_ROUTER=0x3635f71daa996e22867647cc58358c5803133a69
ONELIQ_ROUTER_V4ONLY=0xb1ed79ee288c4631176440b7f4e624c6b4f078f0
ONELIQ_CHECKIN=0x0cccbe2f3acec01d71b38249a1d103117c8473ac

# ─── Third-party contracts on Arc Mainnet ────────────────────────────────────
UNIVERSAL_ROUTER=0x4fca4a51ab4f23a7447b3284fbd7d73289a89fb1
POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
SWAP_ROUTER_02=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77
PERMIT2=0x000000000022d473030f116ddee9f6b43ac78ba3
TOKEN_MESSENGER_V2=0x28b5a0e9c621a5badaa536219b3a228c8168cf5d
MESSAGE_TRANSMITTER_V2=0x81d40f21f12a8f0e3252bccb954d722d4c464b64
GATEWAY_WALLET=0x77777777dcc4d5a8b6e418fd04d8997ef11000ee
GATEWAY_MINTER=0x2222222d7164433c4c09b0b0d809a9b52c04c205

# ─── Edge backend secrets (set as Cloudflare Pages secrets, not here) ────────
# KIT_KEY      — Circle App Kit API key, used by functions/api/circle-proxy/
# GATEWAY_KEY  — optional Gateway bearer, used by functions/api/gateway-proxy/
# Per-chain RPC overrides are read by functions/_rpc.js: RPC_ARC, RPC_ETHEREUM,
# RPC_BASE, RPC_ARBITRUM, RPC_OPTIMISM, RPC_POLYGON, RPC_AVALANCHE, RPC_UNICHAIN.

# ─── Monitoring / alerting ───────────────────────────────────────────────────
# Discord or Slack incoming webhook for health-check.sh alerts.
ALERT_WEBHOOK=

# Tenderly (smart contract monitoring)
TENDERLY_PROJECT=
TENDERLY_USERNAME=
TENDERLY_ACCESS_KEY=

# ─── Multi-sig (read-only references — keys live in hardware wallets) ────────
# Empty today: the router owner is still a single EOA. See docs/GOVERNANCE.md.
TREASURY_SAFE=
CONTRACT_OWNER_SAFE=

# ─── DO NOT add deployer private keys here ───────────────────────────────────
# Use a hardware wallet for any signing. If you ABSOLUTELY need a hot key for
# CI, use a dedicated address with minimal funds and store the key in your CI
# provider's encrypted secrets — never in this file.

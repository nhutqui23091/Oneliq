# Cloudflare Pages / Netlify _headers file
# These are HTTP response headers — they apply on top of the CSP meta tag in each page.
# Headers below CANNOT be set via <meta> and MUST come from the host.

/*
  # NOTE ON script-src: 'unsafe-inline' below is NOT what browsers end up with.
  # functions/_middleware.js rewrites this header on every HTML response,
  # swapping 'unsafe-inline' for a fresh per-request 'nonce-...' and stamping
  # that nonce on the page's own inline <script>. Injected script has no nonce
  # and does not run. The keyword stays here only as the fallback if nonce
  # injection ever throws — a working page under the old policy beats a blank
  # one. Everything else in this policy is the single source of truth; the
  # middleware touches the script-src directive and nothing else.
  #
  # style-src keeps 'unsafe-inline' on purpose: inline style cannot execute,
  # and the pages are built on inline style attributes throughout.
  #
  # Defense-in-depth CSP (matches the meta tag, plus frame-ancestors which meta cannot set).
  # script-src includes esm.sh for Circle App Kit ESM modules (swap, bridge, send).
  # connect-src includes Circle's App Kit API endpoints for swap routing/quotes.
  # font-src includes fonts.reown.com because the AppKit wallet modal ships its own
  # typeface. This header is the permissive floor; the browser enforces the INTERSECTION
  # of header and meta, so pages that never load AppKit (index, docs, blog, status) keep
  # the tighter font-src in their own meta tag and stay locked to fonts.gstatic.com.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.reown.com; img-src 'self' data: blob: https://cryptologos.cc https://assets.coingecko.com https://*.walletconnect.com https://walletconnect.org https://*.reown.com; connect-src 'self' https://cloudflareinsights.com https://rpc.testnet.arc.network https://ethereum-sepolia-rpc.publicnode.com https://sepolia.base.org https://api.avax-test.network https://sepolia-rollup.arbitrum.io https://optimism-sepolia.publicnode.com https://rpc-amoy.polygon.technology https://sepolia.unichain.org https://iris-api-sandbox.circle.com https://gateway-api-testnet.circle.com https://*.circle.com https://api.circle.com https://api.coingecko.com https://esm.sh wss://relay.walletconnect.com wss://relay.walletconnect.org https://verify.walletconnect.com https://api.web3modal.org https://pulse.walletconnect.org https://explorer-api.walletconnect.com https://*.reown.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

  # Block iframe embedding (clickjacking defense). Also covered by frame-ancestors above.
  X-Frame-Options: DENY

  # Force HTTPS for 1 year, include subdomains, signal preload-list eligibility.
  # NOTE: only enable preload after you confirm the domain serves HTTPS on every subdomain.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Stop browsers from MIME-sniffing responses
  X-Content-Type-Options: nosniff

  # Don't leak full URL to third-party origins
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable browser features we never use (camera/mic/geo/etc)
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # Cross-origin isolation (lets future SharedArrayBuffer / WASM features work safely)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store, must-revalidate

/blog/*.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-store, must-revalidate

/
  Cache-Control: no-store, must-revalidate

/assets/arc-core-v2.js
  Cache-Control: no-store, must-revalidate

/assets/arc-ui.js
  Cache-Control: no-store, must-revalidate

/assets/arc-core.js
  Cache-Control: no-store, must-revalidate

/assets/arc-appkit.js
  Cache-Control: no-store, must-revalidate
